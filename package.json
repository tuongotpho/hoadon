{
  "name": "quan-ly-hoa-don",
  "version": "1.0.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gan-o-mau": "node scripts/gan-o-mau.mjs",
    "test:firebase": "firebase emulators:exec --only auth,firestore,storage --project demo-hoadon \"vitest run tests/firebase-store.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:hoadon,storage:hoadon --project app-from-ai",
    "deploy": "npm run build && firebase deploy --only hosting:hoadon-npsc --project app-from-ai"
  },
  "keywords": [],
